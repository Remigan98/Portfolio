@inject IStringLocalizer<SharedResource> Localizer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Localizer["Name"]</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Localizer["AboutMe"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/ishot">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> iShot
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/yumblazor">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> E-Commerce Blazor
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/restaurantapi">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Restaurant API
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/taskmaster-react">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Task Master React
            </NavLink>
        </div>
     
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/shooter-assistant">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Shooter Assistant
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/projects/calmset">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> CalmSet
            </NavLink>
        </div>
        <div class="mt-auto p-3 text-center">
            <CultureSwitcher></CultureSwitcher>
        </div>
    </nav>
</div>

