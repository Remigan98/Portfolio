@page "/"

@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Name"] - Portfolio</PageTitle>

<div class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="/images/profile.jpg" alt="@Localizer["Name"]" class="profile-photo img-fluid rounded-circle shadow-lg" />
            </div>
            <div class="col-md-8">
                <h1 class="display-4 fw-bold mb-3">@Localizer["Name"]</h1>
                <h2 class="h4 text-muted mb-4">.NET Developer | Software Engineer</h2>
                <p class="lead mb-4">
                    I strive to create modern, scalable, and secure IT systems based on .NET technology and the Azure platform. 
                    I specialize in solutions that genuinely support business, are efficient, easy to maintain, and prepared for further development. 
                    I'm motivated by the opportunity to combine solid architecture with practical cloud implementation to deliver software at the highest level.
                </p>
                <div class="contact-info mb-4">
                    <p class="mb-2">
                        <i class="bi bi-envelope-fill me-2"></i>
                        <a href="mailto:@Localizer["EmailAddress"]">@Localizer["EmailAddress"]</a>
                    </p>
                    <p class="mb-2">
                        <i class="bi bi-telephone-fill me-2"></i>
                        <a href="tel:+48722201364">+48 722 201 364</a>
                    </p>
                    <p class="mb-2">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        @Localizer["HomeAddress"]
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Localizer["CvLink"]" target="_blank" class="btn btn-primary">
                        <i class="bi bi-file-pdf me-2"></i>View CV
                    </a>
                    <a href="@Localizer["CvLink"]" download class="btn btn-outline-primary">
                        <i class="bi bi-download me-2"></i>Download CV
                    </a>
                    <a href="https://www.udemy.com/user/remigiusz-ganiec/" target="_blank" class="btn btn-outline-secondary">
                        <i class="bi bi-mortarboard me-2"></i>Udemy Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="experience-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Professional Experience</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">.NET Developer</h3>
                        <p class="text-muted mb-3">Bottega IT Minds | 2019 - Present (6+ years)</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Game & Application Development (.NET, Unity)</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>REST API Development for IShot Virtual Shooting Range</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Azure Cloud Infrastructure Management</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Team Management & Project Coordination</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">Software Engineering Manager</h3>
                        <p class="text-muted mb-3">Augmented Neural Systems | 2022 - 2024 (2+ years)</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>VR Application Development from Scratch</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>REST API Design & Implementation</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>IIS Server Configuration & Management</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>SQL Database Design & Optimization</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="skills-section py-5">
    <div class="container">
        <h2 class="text-center mb-5">Technical Skills</h2>
        <div class="row text-center">
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="skill-item p-3">
                    <i class="bi bi-code-slash display-4 text-primary mb-3"></i>
                    <h4 class="h6">Languages</h4>
                    <p class="text-muted small">C#, Python, C++, SQL, JavaScript</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="skill-item p-3">
                    <i class="bi bi-window-stack display-4 text-primary mb-3"></i>
                    <h4 class="h6">Frameworks</h4>
                    <p class="text-muted small">.NET, Unity, Blazor, ASP.NET Core</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="skill-item p-3">
                    <i class="bi bi-cloud-fill display-4 text-primary mb-3"></i>
                    <h4 class="h6">Cloud & DevOps</h4>
                    <p class="text-muted small">Azure, Windows Server, Linux, IIS</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="skill-item p-3">
                    <i class="bi bi-database-fill display-4 text-primary mb-3"></i>
                    <h4 class="h6">Databases</h4>
                    <p class="text-muted small">SQL Server, Database Design</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="education-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Education & Certifications</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">Master's Degree in Computer Science</h3>
                        <p class="text-muted">University of Economics and Innovation in Lublin</p>
                        <p class="small"><strong>Specialization:</strong> Cybersecurity</p>
                        <p class="small text-muted">2021 - 2022</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">Bachelor's Degree in Computer Science</h3>
                        <p class="text-muted">University of Economics and Innovation in Lublin</p>
                        <p class="small text-muted">2017 - 2021</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <h4 class="h6 mb-3">Recent Certifications</h4>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <span class="badge bg-primary p-2">Blazor - Complete Guide [.NET 9]</span>
                <span class="badge bg-primary p-2">C# Advanced Topics</span>
                <span class="badge bg-primary p-2">ASP.NET Core Web API</span>
                <span class="badge bg-primary p-2">Unit Testing for C#</span>
                <span class="badge bg-primary p-2">CCNA Routing and Switching</span>
                <span class="badge bg-primary p-2">LPIC1 101</span>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .hero-section a {
        color: white;
        text-decoration: none;
    }

    .hero-section a:hover {
        text-decoration: underline;
    }

    .profile-photo {
        width: 250px;
        height: 250px;
        object-fit: cover;
        border: 5px solid white;
    }

    .skill-item {
        transition: transform 0.3s ease;
    }

    .skill-item:hover {
        transform: translateY(-5px);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>