@page "/projects/ishot"

<PageTitle>iShot - Project</PageTitle>

<div class="project-hero py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">iShot – Augmented Reality Shooting Range</h1>
                <p class="lead mb-4">
                    iShot is an augmented reality shooting range platform combining real firearms with interactive digital scenarios. 
                    The system delivers AI-assisted training, multiple game modes, and full body interaction for sport, tactical, and entertainment use cases.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-primary">Unity</span>
                    <span class="badge bg-primary">.NET</span>
                    <span class="badge bg-primary">REST API</span>
                    <span class="badge bg-primary">Azure</span>
                    <span class="badge bg-primary">Computer Vision</span>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="project-image-placeholder rounded shadow-sm">
                    <img src="/images/ishotProfile.gif" alt="iShot Screenshot" class="img-fluid rounded" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="project-section py-5">
    <div class="container">
        <h2 class="h4 mb-4">Overview</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><strong>Role:</strong> Technical Lead & Co-owner</li>
                    <li class="mb-2"><strong>Location:</strong> Lublin, Poland</li>
                    <li class="mb-2"><strong>Project Type:</strong> AR shooting range system</li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><strong>Core Focus:</strong> Gameplay systems, API services, Azure infrastructure</li>
                    <li class="mb-2"><strong>Platforms:</strong> Unity (HDRP/URP), .NET services</li>
                    <li class="mb-2"><strong>Integration:</strong> Web services + game client</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="project-section py-5 bg-light">
    <div class="container">
        <h2 class="h4 mb-4">Key Responsibilities (from CV)</h2>
        <ul class="list-unstyled mb-0">
            <li class="mb-2">Designed and implemented gameplay mechanics and levels in Unity.</li>
            <li class="mb-2">Built REST API services in C# for the iShot system.</li>
            <li class="mb-2">Integrated web services with the game client.</li>
            <li class="mb-2">Managed Azure environment and SQL database design.</li>
            <li class="mb-2">Led the development team and coordinated project work.</li>
            <li class="mb-2">Worked with shaders and VFX using Shader Graph and VFX Graph.</li>
            <li class="mb-2">Developed computer vision components using OpenCV (C# / Python).</li>
        </ul>
    </div>
</div>

<div class="project-section py-5">
    <div class="container">
        <h2 class="h4 mb-4">Tech Highlights</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <h3 class="h6 text-uppercase text-muted">Core Technologies</h3>
                <ul class="list-unstyled mb-0">
                    <li>Unity (HDRP/URP)</li>
                    <li>C# / .NET</li>
                    <li>REST API services</li>
                    <li>Azure infrastructure</li>
                    <li>SQL Server</li>
                </ul>
            </div>
            <div class="col-md-6">
                <h3 class="h6 text-uppercase text-muted">Visuals & Interaction</h3>
                <ul class="list-unstyled mb-0">
                    <li>Shader Graph</li>
                    <li>VFX Graph</li>
                    <li>Lighting & scene configuration</li>
                    <li>UI design and implementation</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="project-section py-5 bg-light">
    <div class="container">
        <h2 class="h4 mb-4">Links</h2>
        <ul class="list-unstyled mb-0">
            <li>
                <strong>Live URL:</strong>
                <a href="https://ishot.systems/" target="_blank" rel="noopener noreferrer">ishot.systems</a>
            </li>
        </ul>
    </div>
</div>

<style>
    .project-hero {
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
        color: white;
    }

    .project-image-placeholder {
        height: 220px;
        background-color: rgba(255, 255, 255, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .project-section h2 {
        font-weight: 700;
    }
</style>
